{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obs-live-editor-auth",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-01",
  "vars": {
    "MINIMUM_CLIENT_VERSION": "0.1.0",
    "LATEST_CLIENT_VERSION": "0.3.1",
    "CLIENT_UPDATE_LEVEL": "optional",
    "CLIENT_UPDATE_MESSAGE": "0.3.1에서 설치 완료 후 OBS 자동 실행 시 발생하던 코드 740 권한 오류를 수정했습니다.",
    "CLIENT_RELEASE_URL": "https://github.com/TereBin/obs-live-editor-releases/releases/latest"
  }
}
