{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obs-live-editor-auth",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-01",
  "vars": {
    "MINIMUM_CLIENT_VERSION": "0.1.0",
    "LATEST_CLIENT_VERSION": "0.3.5",
    "CLIENT_UPDATE_LEVEL": "optional",
    "CLIENT_UPDATE_MESSAGE": "GitHub 저장소 주소를 OBSChzzkLiveEditor 이름으로 통일했습니다.",
    "CLIENT_RELEASE_URL": "https://github.com/TereBin/OBSChzzkLiveEditor-Releases/releases/latest"
  }
}
