{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obs-live-editor-auth",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-01",
  "vars": {
    "MINIMUM_CLIENT_VERSION": "0.1.0",
    "LATEST_CLIENT_VERSION": "0.4.0",
    "CLIENT_UPDATE_LEVEL": "optional",
    "CLIENT_UPDATE_MESSAGE": "OBS 33의 새 플러그인 설치 구조, 미저장 변경 보호, 오류 진단과 자동 재시도를 추가했습니다.",
    "CLIENT_RELEASE_URL": "https://github.com/TereBin/OBSChzzkLiveEditor-Releases/releases/latest"
  }
}
