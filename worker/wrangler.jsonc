{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obs-live-editor-auth",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-01",
  "vars": {
    "MINIMUM_CLIENT_VERSION": "0.1.0",
    "LATEST_CLIENT_VERSION": "0.3.6",
    "CLIENT_UPDATE_LEVEL": "optional",
    "CLIENT_UPDATE_MESSAGE": "OBS 종료 시 도크 위젯이 중복 해제되어 발생할 수 있는 크래시를 수정했습니다.",
    "CLIENT_RELEASE_URL": "https://github.com/TereBin/OBSChzzkLiveEditor-Releases/releases/latest"
  }
}
